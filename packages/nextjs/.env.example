NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# HCS topic the logger posts to (printed by `yarn logger` on first run), for the /log page
NEXT_PUBLIC_HCS_TOPIC_ID=
# Network the topic lives on: testnet (default) or mainnet
NEXT_PUBLIC_HCS_NETWORK=testnet
