# testnet or mainnet
HEDERA_NETWORK=testnet

# The Reserve contract, as 0.0.x or EVM address (printed by `yarn deploy`)
RESERVE_CONTRACT=

# The logger's own Hedera account. Use a separate account with a small balance:
# its key is the topic's submit key, and it never holds or moves reserve funds.
LOGGER_OPERATOR_ID=
LOGGER_OPERATOR_KEY=

# Leave empty on first run to create a topic; the logger prints the new ID. Then set it here.
HCS_TOPIC_ID=

# Optional
# MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# POLL_INTERVAL_MS=10000
# LOGGER_STATE_FILE=.logger-state.json
