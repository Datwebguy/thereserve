# Hedera JSON-RPC endpoint (testnet default, change for mainnet)
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill manually. Run `yarn account:import` (or `yarn account:generate`) first.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# --- The Reserve deployment (all optional; defaults shown) ---

# Chainlink HBAR/USD proxy. Defaults to the official testnet/mainnet address for the network.
# CHAINLINK_HBAR_USD_FEED=
# Oldest price PriceGuard accepts, in seconds: the feed's 24 h heartbeat plus a 1 h margin.
# GUARD_MAX_STALENESS=90000
# Largest move from the last accepted price, in basis points (2000 = 20%).
# GUARD_MAX_JUMP_BPS=2000
# Minimum collateral ratio in basis points (15000 = 150%). Must be at least 11000.
# MIN_RATIO_BPS=15000
# HTS token name and symbol.
# TOKEN_NAME=Reserve USD
# TOKEN_SYMBOL=rUSD
# HBAR sent to pay the HTS token creation fee; the contract refunds what is not used.
# TOKEN_CREATE_HBAR=20
# HBAR deposited by `yarn hardhat:demo`.
# DEMO_DEPOSIT_HBAR=100
